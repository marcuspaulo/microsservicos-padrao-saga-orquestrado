# Modelo do .env — este arquivo É commitado; o .env real NÃO (está no .gitignore).
#
# Como usar:
#   cp .env.example .env
#   chmod 600 .env
#   troque os TROQUE_AQUI pelas senhas do ~/lab/.env do servidor
#
# Os application.yml leem estas variáveis; host/porta já apontam para localhost
# (túnel SSH aberto com: ssh -N contabo-lab).

# product-validation-service, payment-service, inventory-service
DB_PASSWORD=TROQUE_AQUI

# order-service (mesmo formato do valor padrão do application.yml)
MONGO_DB_URI=mongodb://admin:TROQUE_AQUI@localhost:27017
